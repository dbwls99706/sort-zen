{
  "expo": {
    "name": "Sort ZEN",
    "slug": "sort-zen",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "sortzen",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sortzen.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sortzen.app"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6671440092809524~5364355009"
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "./plugins/withPlayGamesServices",
        {
          "appId": "1062360663221"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "242f0f15-698c-4f60-97f9-2720876e9029"
      }
    },
    "owner": "dbwls99706"
  },
  "react-native-google-leaderboards-and-achievements": {
    "projectId": "1062360663221"
  }
}
