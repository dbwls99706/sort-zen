# EAS는 .easignore가 있으면 .gitignore를 무시한다.
# 따라서 .gitignore 제외 항목을 모두 포함해야 한다 (특히 node_modules·네이티브 폴더).

# dependencies — 서버에서 새로 설치하므로 로컬분 업로드 금지 (autolinking 충돌 방지)
node_modules/

# Expo / 생성 네이티브 폴더 — 서버 prebuild가 생성
.expo/
/ios
/android
.kotlin/
web-build/
expo-env.d.ts

# 빌드 산출물 / 스크래치 (런타임 불필요)
_verify/
dist/
scripts/__pycache__/
coverage/
*.apk
*.aab
*.7z

# 키 / 시크릿
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env*.local

# 기타
.metro-health-check*
*.tsbuildinfo
.DS_Store
.claude/
